# ParlTopics – Konfiguration. Kopieren nach .env und Werte eintragen. .env nie committen.

# LLM-Endpunkt (Variablennamen nach Hack-Apertus-Template).
# Modellnamen so eintragen, wie der Endpunkt sie erwartet (Keera: offene Frage 1 im PRD).
LLM_NAME=swiss-ai/Apertus-v1.5-8B
LLM_NAME_LARGE=swiss-ai/Apertus-v1.5-70B
LLM_BASE_URL=https://keera.example/v1
LLM_API_KEY=

# Datenbank (lokal: make db)
DATABASE_URL=postgresql://parltopics:parltopics@localhost:5432/parltopics
POSTGRES_PASSWORD=parltopics

# Klassifikation (PRD 7.3, 7.7)
PARALLEL_8B=16
PARALLEL_70B=4
CONFIDENCE_THRESHOLD=0.6
JOB_TIMEOUT_SECONDS=600
HEARTBEAT_SECONDS=120

# Pfade, relativ zum Arbeitsverzeichnis (im Container gesetzt)
REGISTRY_PATH=registry/tags.yaml
PROMPTS_DIR=prompts
MIGRATIONS_DIR=migrations

# Web-App: Token für schreibende Endpunkte (Review)
REVIEW_TOKEN=

# Docker Compose im Betrieb (AIRGAP.md): feste Verzeichnisse ausserhalb des Bundles.
# Leer lassen für die Entwicklung im Repo.
REGISTRY_DIR=
IMPORT_DIR=
PARLTOPICS_ENV_FILE=
PARLTOPICS_VERSION=dev
