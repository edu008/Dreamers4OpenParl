# ParlTopics – Konfiguration. Kopieren nach .env und Werte eintragen. .env nie committen.

# LLM-Endpunkt (Variablennamen nach Hack-Apertus-Template).
# Apertus über das Keera-Gateway. Im Air-Gap stattdessen den internen Endpunkt eintragen (PRD 10.2).
# Der Client ruft nur diesen Host auf. Modellnamen so, wie der Endpunkt sie unter GET /models
# nennt; `parltopics llm check` listet sie, wenn ein Name fehlt.
LLM_NAME=apertus-v1-5-8b
LLM_NAME_LARGE=apertus-v1-5-70b
LLM_BASE_URL=https://gateway.keera.ch/api/v1
LLM_API_KEY=

# Datenbank (lokal: make db)
DATABASE_URL=postgresql://parltopics:parltopics@localhost:5432/parltopics
POSTGRES_PASSWORD=parltopics

# Klassifikation (PRD 7.3, 7.7)
PARALLEL_8B=20
PARALLEL_70B=12
# single_70b: ein 70B-Durchlauf über alle Themen; two_stage: Kapitel und Themen mit 8B, Eskalation an 70B
CLASSIFY_MODE=single_70b
CONFIDENCE_THRESHOLD=0.6
JOB_TIMEOUT_SECONDS=600
HEARTBEAT_SECONDS=120

# Seitenbaum und Zusammenfassungen (PRD 7.9)
# Neue Zusammenfassung einer Tag-Seite ab PAGE_TAG_CHANGES neuen oder geänderten Geschäften,
# einer Eltern-Seite ab PAGE_PARENT_CHANGES geänderten Unterseiten, sonst nach PAGE_MAX_AGE_DAYS.
PAGE_TAG_CHANGES=5
PAGE_PARENT_CHANGES=1
PAGE_MAX_AGE_DAYS=7
# Unter PAGE_MIN_AFFAIRS Geschäften keine Zusammenfassung durch das Modell.
PAGE_MIN_AFFAIRS=3
PAGE_WINDOW_MONTHS=12
# Eingabegrenzen je Prompt: Geschäfte einer Tag-Seite, Stichproben je Eltern-Seite, Token (Schätzung).
PAGE_MAX_AFFAIRS=80
PAGE_SAMPLES=12
PAGE_PROMPT_MAX_TOKENS=24000

# Navigationssuche (PRD 7.10)
NAVIGATE_MAX_STEPS=8
NAVIGATE_MIN_RELEVANCE=0.3
NAVIGATE_MAX_BRANCHES=2
NAVIGATE_MAX_CANDIDATES=20

# Pfade, relativ zum Arbeitsverzeichnis (im Container gesetzt)
REGISTRY_PATH=registry/tags.yaml
PROMPTS_DIR=prompts
MIGRATIONS_DIR=migrations
WEB_DIST_DIR=web/dist

# Docker Compose im Betrieb (AIRGAP.md): feste Verzeichnisse ausserhalb des Bundles.
# Leer lassen für die Entwicklung im Repo.
REGISTRY_DIR=
IMPORT_DIR=
PARLTOPICS_ENV_FILE=
PARLTOPICS_VERSION=dev
