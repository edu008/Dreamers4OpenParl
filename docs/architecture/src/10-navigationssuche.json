  "cards": [
    {
      "dot": "cyan",
      "title": "Vergleich statt Einzelbewertung",
      "items": [
        "An jedem Knoten bewertet 8B alle Kinder in einem Prompt",
        "Der erste Schritt liest auch Jahr, Parlament, Ebene und Typ als Filter"
      ]
    },
    {
      "dot": "amber",
      "title": "Grenzen und Rückweg",
      "items": [
        "Höchstens 8 Modellaufrufe samt Fallback, höchstens 2 Äste je Knoten, Mindestrelevanz 0.3",
        "Liefert ein Ast nichts, geht die Suche zum nächstbesten Geschwister zurück",
        "Findet der Baum nichts, greift die Volltextsuche"
      ]
    },
    {
      "dot": "emerald",
      "title": "Belegte Antwort",
      "items": [
        "Jede Aussage nennt Geschäfts-IDs, der Code prüft sie",
        "Die Antwort zeigt den Suchweg; ohne Treffer gibt es keine Antwort",
        "Der Agent nutzt dieselbe Suche als Werkzeug navigate_tree"
      ]
    }
