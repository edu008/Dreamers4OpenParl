  "cards": [
    {
      "dot": "cyan",
      "title": "Täglicher Lauf",
      "items": [
        "parltopics daily verkettet Ingest, Input, Registry, Klassifikation, Vorschläge, Seiten, Export und Wiki",
        "Nur neue oder geänderte Geschäfte, erkannt über input_hash und scheme_hash",
        "Seitenlauf: nur offene Seiten, von den Tag-Seiten bis Heart"
      ]
    },
    {
      "dot": "rose",
      "title": "Eskalation",
      "items": [
        "70B bei Konfidenz unter Schwelle, Vorschlag, unbekannter Sprache oder in der 2-%-Stichprobe",
        "Das 8B-Ergebnis bleibt als superseded gespeichert"
      ]
    },
    {
      "dot": "emerald",
      "title": "Mensch entscheidet",
      "items": [
        "Vorschläge werden nach dem Lauf gruppiert und erst im Review aktiv",
        "Freigaben schreiben registry/tags.yaml und öffnen nur reclassify-Jobs",
        "Labels sind sofort sichtbar; Review bestätigt oder korrigiert sie"
      ]
    }
