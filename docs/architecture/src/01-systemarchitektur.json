  "cards": [
    {
      "dot": "cyan",
      "title": "Offline zur Laufzeit",
      "items": [
        "Einziger Netzwerkzugriff: LLM_BASE_URL, Allowlist im HTTP-Client",
        "Hack: Keera (gateway.keera.ch/api/v1). Air-Gap: Apertus-Endpunkt im internen Netz",
        "Web-App als statischer Build im Image, Systemschriften, kein CDN",
        "Daten kommen als Import-Bündel per Datenträger"
      ]
    },
    {
      "dot": "emerald",
      "title": "KI-Rollen",
      "items": [
        "Worker: deterministisch, ein Geschäft pro Aufruf, 8B mit Eskalation an 70B",
        "Seitenlauf: Zusammenfassungen von den Tag-Seiten bis Heart, nur offene Seiten",
        "Suche: Themen aus der Registry; erkennt sie keines, schlägt 8B höchstens zwei vor",
        "Navigationssuche: 8B vergleicht je Knoten alle Kinder, 70B wählt am Blatt",
        "Agent: Tool-Calling mit 70B, nur lesende Werkzeuge, auch navigate_tree"
      ]
    },
    {
      "dot": "rose",
      "title": "Mensch entscheidet",
      "items": [
        "Review in der Web-App bestätigt, verwirft, ersetzt und ergänzt Labels",
        "Nur Review-Aktionen schreiben registry/tags.yaml",
        "Export und DVS-Liste entstehen per CLI aus PostgreSQL"
      ]
    }
  ]
